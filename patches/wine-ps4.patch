From 389a695ad345828b757c71dcc95e87743c4a6220 Mon Sep 17 00:00:00 2001
From: iHaiDeeZ <ihaideezi@gmail.com>
Date: Sun, 1 Nov 2026 01:29:00 +0300
Subject: [PATCH 10/38] WinePS4: wineserver does not kill the app when a
 program ends

---
 server/process.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/server/process.c b/server/process.c
index a06aa83..81e8555 100644
--- a/server/process.c
+++ b/server/process.c
@@ -625,6 +625,15 @@ static void process_sigkill( void *private )
     struct process *process = private;
     int signal = 0;
 
+#ifdef __PS4_WINE__
+    /* the program ran in this process (a thread of it): nothing to wait for, nothing to kill */
+    if (process->unix_pid == getpid())
+    {
+        process->sigkill_timeout = NULL;
+        process_died( process );
+        return;
+    }
+#endif
     process->sigkill_delay *= 2;
     if (process->sigkill_delay >= TICKS_PER_SEC / 2)
         signal = SIGKILL;
