From 6b25b0966fbee097654e862ad4b51998b6313e52 Mon Sep 17 00:00:00 2001
From: iHaiDeeZ <ihaideezi@gmail.com>
Date: Sat, 31 Oct 2026 23:43:18 +0300
Subject: [PATCH 07/38] WinePS4: 32-bit programs (WoW64): cs 0x33, fs 0x13 with
 its base switched by sysarch at the Unix side boundaries; wow64cpu skips
 reloading an unchanged fs

---
 dlls/ntdll/unix/signal_x86_64.c | 97 +++++++++++++++++++++++++++++++++
 dlls/wow64cpu/cpu.c             |  6 +-
 2 files changed, 102 insertions(+), 1 deletion(-)

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 43068f9..dd223f7 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -507,6 +507,7 @@ struct amd64_thread_data
     void                **instrumentation_callback; /* 0330 */
     DWORD                 fs;            /* 0338 WOW TEB selector */
     DWORD                 mxcsr;         /* 033c Unix-side mxcsr register */
+    void                 *wow_fsbase;    /* 0340 PS4: the 32-bit TEB, FS's base outside the Unix side */
 };
 
 C_ASSERT( sizeof(struct amd64_thread_data) <= sizeof(((struct ntdll_thread_data *)0)->cpu_data) );
@@ -515,6 +516,17 @@ C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, fra
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, instrumentation_callback ) == 0x330 );
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, fs ) == 0x338 );
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, mxcsr ) == 0x33c );
+C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, wow_fsbase ) == 0x340 );
+
+#ifdef __PS4_WINE__
+/* FS's base, with no C library in between (its errno is thread data FS may not reach yet) */
+static inline void ps4_set_fsbase( void *const *base )
+{
+    long ret;
+    __asm__ volatile( "syscall" : "=a" (ret) : "a" (165 /* SYS_sysarch */), "D" (129 /* AMD64_SET_FSBASE */),
+                      "S" (base) : "rcx", "rdx", "r8", "r9", "r10", "r11", "memory", "cc" );
+}
+#endif
 
 static inline struct amd64_thread_data *amd64_thread_data(void)
 {
@@ -909,6 +921,11 @@ static inline ucontext_t *init_handler( void *sigcontext )
 {
 #ifdef __PS4_WINE__
     amd64_set_gsbase( get_current_teb() );
+    if (fs32_sel)
+    {
+        struct amd64_thread_data *thread_data = (struct amd64_thread_data *)&get_current_teb()->GdiTebBatch;
+        if (thread_data->pthread_teb) ps4_set_fsbase( &thread_data->pthread_teb );
+    }
 #endif
     clear_alignment_flag();
 #ifdef __linux__
@@ -950,6 +967,14 @@ static inline void leave_handler( ucontext_t *sigcontext )
     if (!is_inside_signal_stack( (void *)RSP_sig(sigcontext )) &&
         !is_inside_syscall( RSP_sig(sigcontext )))
         _thread_set_tsd_base( (uint64_t)NtCurrentTeb() );
+#elif defined __PS4_WINE__
+    if (fs32_sel &&
+        !is_inside_signal_stack( (void *)RSP_sig(sigcontext )) &&
+        !is_inside_syscall( RSP_sig(sigcontext )))
+    {
+        struct amd64_thread_data *thread_data = (struct amd64_thread_data *)&get_current_teb()->GdiTebBatch;
+        if (thread_data->wow_fsbase) ps4_set_fsbase( &thread_data->wow_fsbase );
+    }
 #endif
     if (is_16bit( sigcontext )) return;
 #ifdef DS_sig
@@ -1817,6 +1842,16 @@ __ASM_GLOBAL_FUNC( call_user_mode_callback,
                    "movl $0x3000003,%eax\n\t"  /* _thread_set_tsd_base */
                    "syscall\n\t"
                    "movq %r10,%rcx\n\t"
