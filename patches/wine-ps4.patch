+    off_t                park_pos;    /* its file pointer when it was parked */
+    unsigned int         parked :1;   /* closed for the app's file budget, opened again when next used */
+    unsigned int         in_lru :1;   /* in park_lru (open, and could be parked) */
+    unsigned int         is_dup :1;   /* made by dup_fd_object: shares its file pointer with others */
+    unsigned int         last_used;   /* the request that last used it (ps4_request_seq) */
+    struct thread       *pin_thread;  /* lent to this thread (get_handle_fd) until its next request */
+    unsigned int         pin_requests;/* (that thread's requests when it was lent) */
+    struct list          park_entry;  /* entry in park_lru */
+#endif
 };
 
 static void fd_dump( struct object *obj, int verbose );
 static struct object *fd_get_sync( struct object *obj );
 static void fd_destroy( struct object *obj );
+#ifdef __PS4_WINE__
+static void park_untrack( struct fd *fd );  /* (the PS4's file budget, below) */
+static void park_touch( struct fd *fd );
+static int unpark_fd( struct fd *fd );
+#endif
 
 static const struct object_ops fd_ops =
 {
@@ -1281,6 +1297,10 @@ static int set_unix_lock( struct fd *fd, file_pos_t start, file_pos_t end, int t
         if (!end || end > max_unix_offset) fl.l_len = 0;
         else fl.l_len = end - start;
         if (fcntl( fd->unix_fd, F_SETLK, &fl ) != -1) return 1;
+#ifdef __PS4_WINE__
+    if (fd->parked && !unpark_fd( fd )) return 0;
+    park_touch( fd );
+#endif
 
         switch(errno)
         {
@@ -1596,6 +1616,10 @@ static void fd_destroy( struct object *obj )
 
     if (fd->map_addr) free_map_addr( fd->map_addr, fd->map_size );
     if (fd->completion) release_object( fd->completion );
+#ifdef __PS4_WINE__
+    park_untrack( fd );
+    if (fd->pin_thread) release_object( fd->pin_thread );
+#endif
     remove_fd_locks( fd );
     list_remove( &fd->inode_entry );
     if (fd->poll_index != -1) remove_poll_user( fd, fd->poll_index );
@@ -1700,6 +1724,187 @@ static inline void unmount_fd( struct fd *fd )
     fd->fs_locks = 0;
 }
 
+#ifdef __PS4_WINE__
+/* --- The PS4's file budget ------------------------------------------------------------------------
+ * The PS4 counts the files an app has open, all its processes together, and stops at about 250
+ * (PS5_MihawkOS measured it on the PS5; WinePS4 v00.49: Steam's web helper could not load its DLLs,
+ * "Too many open files" with about 190 open here). Every file of every program is open here, in
+ * wineserver, and most sit idle (a DLL's image once mapped, a log between writes): beyond PARK_HIGH the
+ * least recently used are closed ("parked"), and opened again by name, at the same file pointer, when
+ * next used. A file lent to a program (get_handle_fd) stays open until that thread's next request, by
+ * when it has closed its copy: programs keep no files or folders in their fd cache (get_handle_fd). */
+#define PARK_HIGH 128
+#define PARK_LOW  100
+
+unsigned int ps4_request_seq;                          /* counts the requests (call_req_handler) */
+static struct list park_lru = LIST_INIT( park_lru );   /* parkable fds that are open, most recently used first */
+static unsigned int park_open, park_count, reopen_count, reopen_failures, park_next_log = 1;
+
+/* for port/ps4_wine_dirs.c's census: open, parked so far, opened again, failed */
+void ps4_park_stats( unsigned int stats[4] )
+{
+    stats[0] = park_open;
+    stats[1] = park_count;
+    stats[2] = reopen_count;
+    stats[3] = reopen_failures;
+}
+
+static void park_init( struct fd *fd )
+{
+    fd->unix_flags = -1;
+    fd->park_pos = 0;
+    fd->parked = fd->in_lru = fd->is_dup = 0;
+    fd->last_used = 0;
+    fd->pin_thread = NULL;
+    fd->pin_requests = 0;
+    list_init( &fd->park_entry );
+}
+
+static void park_untrack( struct fd *fd )
+{
+    if (!fd->in_lru) return;
+    list_remove( &fd->park_entry );
+    list_init( &fd->park_entry );
+    fd->in_lru = 0;
+    park_open--;
+}
+
+static void park_touch( struct fd *fd )
+{
+    fd->last_used = ps4_request_seq;
+    if (!fd->in_lru) return;
+    list_remove( &fd->park_entry );
+    list_add_head( &park_lru, &fd->park_entry );
+}
+
+/* lent to a thread that has not made a request since */
+static int fd_lent( struct fd *fd )
+{
+    if (!fd->pin_thread) return 0;
+    if (fd->pin_thread->state != TERMINATED && fd->pin_thread->ps4_requests == fd->pin_requests) return 1;
+    release_object( fd->pin_thread );
+    fd->pin_thread = NULL;
+    return 0;
+}
+
+static int fd_parkable( struct fd *fd )
+{
+    struct fd *other;
+
+    if (!fd->in_lru || fd->unix_fd == -1) return 0;
+    if (fd->last_used == ps4_request_seq) return 0;  /* (this request may be using its descriptor) */
+    if (!list_empty( &fd->inode->locks )) return 0;  /* (the app's POSIX locks on the file would go) */
+    if (fd->poll_index != -1 && pollfd[fd->poll_index].fd != -1) return 0;
+    if (async_queued( &fd->read_q ) || async_queued( &fd->write_q ) || async_queued( &fd->wait_q )) return 0;
+    if (fd_lent( fd )) return 0;
+    /* a dup and the fd it came from share one file pointer (and one place in the budget): neither
+     * while the other is open */
+    LIST_FOR_EACH_ENTRY( other, &fd->inode->open, struct fd, inode_entry )
+        if (other != fd && other->unix_fd != -1 && (fd->is_dup || other->is_dup)) return 0;
+    return 1;
+}
+
+static void park_fd( struct fd *fd )
+{
+    struct stat st;
+
+    /* (one deleted under its name could not be opened again: it stays) */
+    if (fstat( fd->unix_fd, &st ) == -1 || !st.st_nlink)
+    {
+        park_untrack( fd );
+        return;
+    }
+    fd->park_pos = lseek( fd->unix_fd, 0, SEEK_CUR );
+    close( fd->unix_fd );
+    fd->unix_fd = -1;
+    if (fd->closed) fd->closed->unix_fd = -1;
+    fd->parked = 1;
+    park_untrack( fd );
+    park_count++;
+}
+
+/* parks the least recently used ones until keep are open */
+static void park_files( unsigned int keep )
+{
+    struct list *ptr, *prev;
+
+    for (ptr = list_tail( &park_lru ); ptr && park_open > keep; ptr = prev)
+    {
+        prev = list_prev( &park_lru, ptr );
+        if (fd_parkable( LIST_ENTRY( ptr, struct fd, park_entry ))) park_fd( LIST_ENTRY( ptr, struct fd, park_entry ));
+    }
+    if (park_count >= park_next_log)
+    {
+        fprintf( stderr, "wineps4: files: %u parked, %u opened again (%u failed), %u open now\n",
+                 park_count, reopen_count, reopen_failures, park_open );
+        park_next_log = park_count < 1000 ? park_count + 100 : park_count + 2000;
+    }
+}
+
+/* the budget is out (an open got EMFILE or ENFILE): everything parked that can be (mapping.c too) */
+void ps4_park_all( void )
+{
+    park_files( 0 );
+}
+
+/* open, and once more after parking all it can when the app's budget is out */
+static int park_open_file( const char *name, int flags, mode_t mode )
+{
+    int unix_fd = open( name, flags, mode );
+
+    if (unix_fd == -1 && (errno == EMFILE || errno == ENFILE))
+    {
+        park_files( 0 );
+        unix_fd = open( name, flags, mode );
+    }
+    return unix_fd;
+}
+
+/* an fd of a file or folder opened by name: parked when unused for long */
+static void park_track( struct fd *fd, int unix_flags )
+{
+    if (!fd->inode || !fd->unix_name || unix_flags == -1 || fd->unix_fd == -1) return;
+    fd->unix_flags = unix_flags & ~(O_CREAT | O_EXCL | O_TRUNC);
+    fd->last_used = ps4_request_seq;
+    if (!fd->in_lru)
+    {
+        list_add_head( &park_lru, &fd->park_entry );
+        fd->in_lru = 1;
+        park_open++;
+    }
+    if (park_open > PARK_HIGH) park_files( PARK_LOW );
+}
+
+/* a parked fd opened again: 0 (the error set) when its name has another file now, or none */
+static int unpark_fd( struct fd *fd )
+{
+    struct stat st;
+    int unix_fd;
+
+    if (!fd->parked) return 1;
+    if ((unix_fd = park_open_file( fd->unix_name, fd->unix_flags, 0 )) == -1)
+    {
+        file_set_error();
+        reopen_failures++;
+        return 0;
+    }
+    if (fstat( unix_fd, &st ) == -1 || st.st_ino != fd->inode->ino || st.st_dev != fd->inode->device->dev)
+    {
+        close( unix_fd );
+        set_error( STATUS_FILE_INVALID );
+        reopen_failures++;
+        return 0;
+    }
+    if (fd->park_pos > 0 && !(fd->unix_flags & O_APPEND)) lseek( unix_fd, fd->park_pos, SEEK_SET );
+    fd->unix_fd = unix_fd;
+    if (fd->closed) fd->closed->unix_fd = unix_fd;
+    fd->parked = 0;
+    reopen_count++;
+    park_track( fd, fd->unix_flags );
+    return 1;
+}
+#endif
+
 /* allocate an fd object, without setting the unix fd yet */
 static struct fd *alloc_fd_object(void)
 {
@@ -1731,6 +1936,9 @@ static struct fd *alloc_fd_object(void)
     init_async_queue( &fd->wait_q );
     list_init( &fd->inode_entry );
     list_init( &fd->locks );
+#ifdef __PS4_WINE__
+    park_init( fd );
+#endif
 
     if (!(fd->sync = create_internal_sync( 1, 1 ))) goto error;
     if ((fd->poll_index = add_poll_user( fd )) == -1) goto error;
@@ -1774,6 +1982,9 @@ struct fd *alloc_pseudo_fd( const struct fd_ops *fd_user_ops, struct object *use
     init_async_queue( &fd->wait_q );
     list_init( &fd->inode_entry );
     list_init( &fd->locks );
+#ifdef __PS4_WINE__
+    park_init( fd );
+#endif
 
     if (!(fd->sync = create_internal_sync( 1, 1 )))
     {
@@ -1787,9 +1998,12 @@ struct fd *alloc_pseudo_fd( const struct fd_ops *fd_user_ops, struct object *use
 struct fd *dup_fd_object( struct fd *orig, unsigned int access, unsigned int sharing, unsigned int options )
 {
     unsigned int err;
-    struct fd *fd = alloc_fd_object();
+    struct fd *fd;
 
-    if (!fd) return NULL;
+#ifdef __PS4_WINE__
+    if (orig->parked && !unpark_fd( orig )) return NULL;
+#endif
+    if (!(fd = alloc_fd_object())) return NULL;
 
     fd->options    = options;
     fd->cacheable  = orig->cacheable;
@@ -1826,6 +2040,10 @@ struct fd *dup_fd_object( struct fd *orig, unsigned int access, unsigned int sha
             set_error( err );
             goto failed;
         }
+#ifdef __PS4_WINE__
+        fd->is_dup = 1;
+        park_track( fd, orig->unix_flags );
+#endif
     }
     else if ((fd->unix_fd = dup( orig->unix_fd )) == -1)
     {
@@ -1925,6 +2143,9 @@ struct fd *open_fd( struct fd *root, const char *name, struct unicode_str nt_nam
     int root_fd = -1;
     int rw_mode;
     char *path;
+#ifdef __PS4_WINE__
+    int open_flags = -1;
+#endif
 
     if (((options & FILE_DELETE_ON_CLOSE) && !(access & DELETE)) ||
         ((options & FILE_DIRECTORY_FILE) && (flags & O_TRUNC)))
@@ -1974,13 +2195,22 @@ struct fd *open_fd( struct fd *root, const char *name, struct unicode_str nt_nam
     }
     else rw_mode = O_RDONLY;
 
+#ifdef __PS4_WINE__
+    open_flags = rw_mode | (flags & ~O_TRUNC);
+    if ((fd->unix_fd = park_open_file( name, open_flags, *mode )) == -1)
+#else
     if ((fd->unix_fd = open( name, rw_mode | (flags & ~O_TRUNC), *mode )) == -1)
+#endif
     {
         /* if we tried to open a directory for write access, retry read-only */
         if (errno == EISDIR)
         {
             if ((access & FILE_UNIX_WRITE_ACCESS) || (flags & O_CREAT))
+#ifdef __PS4_WINE__
+                fd->unix_fd = park_open_file( name, open_flags = O_RDONLY | (flags & ~(O_TRUNC | O_CREAT | O_EXCL)), *mode );
+#else
                 fd->unix_fd = open( name, O_RDONLY | (flags & ~(O_TRUNC | O_CREAT | O_EXCL)), *mode );
+#endif
         }
 
         if (fd->unix_fd == -1)
@@ -2027,6 +2257,9 @@ struct fd *open_fd( struct fd *root, const char *name, struct unicode_str nt_nam
         fd->cacheable = !inode->device->removable;
         list_add_head( &inode->open, &fd->inode_entry );
         closed_fd = NULL;
+#ifdef __PS4_WINE__
+        park_track( fd, open_flags );
+#endif
 
         /* check directory options */
         if ((options & FILE_DIRECTORY_FILE) && !S_ISDIR(st.st_mode))
@@ -2143,6 +2376,10 @@ int is_fd_overlapped( struct fd *fd )
