From e83d22beb82d7f74c3b2a9031d4fcc1cbd44653b Mon Sep 17 00:00:00 2001
From: iHaiDeeZ <ihaideezi@gmail.com>
Date: Thu, 5 Nov 2026 00:02:53 +0300
Subject: [PATCH 36/38] PS4: bcrypt's Unix half on OpenSSL's libcrypto (RSA and
 ECC public keys, signature checks, AES CBC/ECB/CFB8/GCM): crypt32 verifies
 ECDSA certificate chains through it

---
 dlls/bcrypt/ps4.c | 921 ++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 921 insertions(+)
 create mode 100644 dlls/bcrypt/ps4.c

diff --git a/dlls/bcrypt/ps4.c b/dlls/bcrypt/ps4.c
new file mode 100644
index 0000000..7792869
--- /dev/null
+++ b/dlls/bcrypt/ps4.c
@@ -0,0 +1,921 @@
+/*
+ * Copyright 2026 WinePS4
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+/*
+ * bcrypt's Unix half on the PS4 (WinePS4), on OpenSSL's libcrypto in place of GnuTLS, which the PS4
+ * hasn't got. Without one, crypt32 could check no ECDSA signature (they go through
+ * BCryptVerifySignature): Steam's servers' certificates failed ("Crypto API failed certificate
+ * check, error flags 0x00000008", CERT_TRUST_IS_NOT_SIGNATURE_VALID) and it never logged in.
+ * Here: RSA and ECC public keys imported, signatures verified (ECDSA; RSA with PKCS #1 or PSS), keys
+ * duplicated and destroyed; AES in CBC, ECB (CBC from a zero vector, block by block, as with
+ * GnuTLS), CFB8 and GCM. Key generation, private keys, signing, RSA encryption, export and key
+ * agreement are not here (STATUS_NOT_IMPLEMENTED).
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* (OpenSSL's types before wincrypt.h, whose X509_NAME and others are macros) */
+#include <openssl/bn.h>
+#include <openssl/core_names.h>
+#include <openssl/ec.h>
+#include <openssl/evp.h>
+#include <openssl/param_build.h>
+#include <openssl/rsa.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "ntsecapi.h"
+#include "wincrypt.h"
+#include "bcrypt.h"
+
+#include "bcrypt_internal.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(bcrypt);
+
+/* a key's backend data: an asymmetric key's EVP_PKEY, a symmetric key's cipher state */
+#define KEY_PKEY(key)  (*(EVP_PKEY **)&(key)->private[0])
+#define KEY_STATE(key) (*(struct cipher_state **)&(key)->private[0])
+
+static NTSTATUS ps4_process_attach( void *args )
+{
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS ps4_process_detach( void *args )
+{
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS not_implemented( void *args )
+{
+    FIXME( "not on the PS4 yet\n" );
+    return STATUS_NOT_IMPLEMENTED;
+}
+
+/* --- Symmetric keys ---------------------------------------------------------------------------- */
+
+struct cipher_state
+{
+    EVP_CIPHER_CTX *ctx;
+    EVP_CIPHER_CTX *shadow;  /* GCM decryption: the plaintext encrypted again, for the tag */
+    int             encrypt;
+    UCHAR          *aad;     /* GCM: the authenticated data, given before the direction is known */
+    ULONG           aad_len;
+};
+
+static const EVP_CIPHER *get_cipher( const struct key *key )
+{
+    if (key->alg_id != ALG_ID_AES)
+    {
+        FIXME( "algorithm %u not supported\n", key->alg_id );
+        return NULL;
+    }
+    switch (key->u.s.mode)
+    {
+    case CHAIN_MODE_GCM:
+        if (key->u.s.secret_len == 16) return EVP_aes_128_gcm();
+        if (key->u.s.secret_len == 24) return EVP_aes_192_gcm();
+        if (key->u.s.secret_len == 32) return EVP_aes_256_gcm();
+        break;
+    case CHAIN_MODE_ECB:  /* (CBC from a zero vector: bcrypt starts it again for every block) */
+    case CHAIN_MODE_CBC:
+        if (key->u.s.secret_len == 16) return EVP_aes_128_cbc();
+        if (key->u.s.secret_len == 24) return EVP_aes_192_cbc();
+        if (key->u.s.secret_len == 32) return EVP_aes_256_cbc();
+        break;
+    case CHAIN_MODE_CFB:
+        if (key->u.s.secret_len == 16) return EVP_aes_128_cfb8();
+        if (key->u.s.secret_len == 24) return EVP_aes_192_cfb8();
+        if (key->u.s.secret_len == 32) return EVP_aes_256_cfb8();
+        break;
+    default:
+        break;
+    }
+    FIXME( "AES mode %u with key length %u not supported\n", key->u.s.mode, key->u.s.secret_len );
+    return NULL;
+}
+
+static void free_state( struct cipher_state *state )
+{
+    if (!state) return;
+    EVP_CIPHER_CTX_free( state->ctx );
+    EVP_CIPHER_CTX_free( state->shadow );
+    free( state->aad );
+    free( state );
+}
+
+static EVP_CIPHER_CTX *new_ctx( const struct key *key, const EVP_CIPHER *cipher, int encrypt )
+{
+    static const UCHAR zero[16];
+    const UCHAR *iv = key->u.s.vector ? key->u.s.vector : zero;
+    EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
+
+    if (!ctx) return NULL;
+    if (key->u.s.mode == CHAIN_MODE_GCM)
+    {
+        if (EVP_CipherInit_ex( ctx, cipher, NULL, NULL, NULL, encrypt ) <= 0 ||
+            (key->u.s.vector && EVP_CIPHER_CTX_ctrl( ctx, EVP_CTRL_GCM_SET_IVLEN, key->u.s.vector_len, NULL ) <= 0) ||
+            EVP_CipherInit_ex( ctx, NULL, NULL, key->u.s.secret, iv, encrypt ) <= 0)
+            goto failed;
+    }
+    else if (EVP_CipherInit_ex( ctx, cipher, NULL, key->u.s.secret, iv, encrypt ) <= 0) goto failed;
+    EVP_CIPHER_CTX_set_padding( ctx, 0 );  /* (bcrypt pads itself) */
+    return ctx;
+
+failed:
+    EVP_CIPHER_CTX_free( ctx );
+    return NULL;
+}
+
+/* the key's cipher, going the given way (a new one when it went the other) */
+static NTSTATUS init_cipher( struct key *key, int encrypt )
+{
+    struct cipher_state *state = KEY_STATE(key);
+    const EVP_CIPHER *cipher;
+    int len;
+
+    if (state && state->ctx && state->encrypt == encrypt) return STATUS_SUCCESS;
+    if (!(cipher = get_cipher( key ))) return STATUS_NOT_SUPPORTED;
+    if (!state && !(state = calloc( 1, sizeof(*state) ))) return STATUS_NO_MEMORY;
+    KEY_STATE(key) = state;
+    EVP_CIPHER_CTX_free( state->ctx );
+    EVP_CIPHER_CTX_free( state->shadow );
+    state->ctx = state->shadow = NULL;
+    if (!(state->ctx = new_ctx( key, cipher, encrypt ))) return STATUS_INTERNAL_ERROR;
+    if (key->u.s.mode == CHAIN_MODE_GCM && !encrypt && !(state->shadow = new_ctx( key, cipher, 1 )))
+        return STATUS_INTERNAL_ERROR;
+    state->encrypt = encrypt;
+    if (state->aad_len)
+    {
+        if (EVP_CipherUpdate( state->ctx, NULL, &len, state->aad, state->aad_len ) <= 0) return STATUS_INTERNAL_ERROR;
+        if (state->shadow && EVP_CipherUpdate( state->shadow, NULL, &len, state->aad, state->aad_len ) <= 0)
+            return STATUS_INTERNAL_ERROR;
+    }
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS key_symmetric_vector_reset( void *args )
+{
+    struct key *key = args;
+
+    free_state( KEY_STATE(key) );
+    KEY_STATE(key) = NULL;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS key_symmetric_set_auth_data( void *args )
+{
+    const struct key_symmetric_set_auth_data_params *params = args;
+    struct key *key = params->key;
+    struct cipher_state *state = KEY_STATE(key);
+    UCHAR *aad;
+    int len;
+
+    if (!params->auth_data) return STATUS_SUCCESS;
+    if (state && state->ctx)  /* (going already: straight in) */
+    {
+        if (EVP_CipherUpdate( state->ctx, NULL, &len, params->auth_data, params->len ) <= 0) return STATUS_INTERNAL_ERROR;
+        if (state->shadow && EVP_CipherUpdate( state->shadow, NULL, &len, params->auth_data, params->len ) <= 0)
+            return STATUS_INTERNAL_ERROR;
+        return STATUS_SUCCESS;
+    }
+    if (!state && !(state = calloc( 1, sizeof(*state) ))) return STATUS_NO_MEMORY;
+    KEY_STATE(key) = state;
+    if (!(aad = realloc( state->aad, state->aad_len + params->len ))) return STATUS_NO_MEMORY;
+    memcpy( aad + state->aad_len, params->auth_data, params->len );
+    state->aad = aad;
+    state->aad_len += params->len;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS key_symmetric_encrypt( void *args )
+{
+    const struct key_symmetric_encrypt_params *params = args;
+    NTSTATUS status;
+    int len;
+
+    if ((status = init_cipher( params->key, 1 ))) return status;
+    if (params->output_len < params->input_len) return STATUS_BUFFER_TOO_SMALL;
+    if (EVP_CipherUpdate( KEY_STATE(params->key)->ctx, params->output, &len, params->input, params->input_len ) <= 0)
+        return STATUS_INTERNAL_ERROR;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS key_symmetric_decrypt( void *args )
+{
+    const struct key_symmetric_decrypt_params *params = args;
+    struct cipher_state *state;
+    NTSTATUS status;
+    int len;
+
+    if ((status = init_cipher( params->key, 0 ))) return status;
+    if (params->output_len < params->input_len) return STATUS_BUFFER_TOO_SMALL;
+    state = KEY_STATE(params->key);
+    if (EVP_CipherUpdate( state->ctx, params->output, &len, params->input, params->input_len ) <= 0)
+        return STATUS_INTERNAL_ERROR;
+    if (state->shadow)
+    {
+        UCHAR *scratch = malloc( params->input_len ? params->input_len : 1 );
+
+        if (!scratch) return STATUS_NO_MEMORY;
+        if (EVP_CipherUpdate( state->shadow, scratch, &len, params->output, params->input_len ) <= 0)
+        {
+            free( scratch );
+            return STATUS_INTERNAL_ERROR;
+        }
+        free( scratch );
+    }
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS key_symmetric_get_tag( void *args )
+{
+    const struct key_symmetric_get_tag_params *params = args;
+    struct cipher_state *state;
+    EVP_CIPHER_CTX *ctx;
+    UCHAR rest[32];
+    NTSTATUS status;
+    int len;
+
+    if (params->key->u.s.mode != CHAIN_MODE_GCM) return STATUS_NOT_SUPPORTED;
+    if (!(state = KEY_STATE(params->key)) || !state->ctx)  /* (nothing went through: the tag of nothing) */
+        if ((status = init_cipher( params->key, 1 ))) return status;
+    state = KEY_STATE(params->key);
+    ctx = state->encrypt ? state->ctx : state->shadow;
+    if (EVP_EncryptFinal_ex( ctx, rest, &len ) <= 0 ||
+        EVP_CIPHER_CTX_ctrl( ctx, EVP_CTRL_GCM_GET_TAG, params->len, params->tag ) <= 0)
+        return STATUS_INTERNAL_ERROR;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS key_symmetric_destroy( void *args )
+{
+    struct key *key = args;
+
+    free_state( KEY_STATE(key) );
+    KEY_STATE(key) = NULL;
+    return STATUS_SUCCESS;
+}
+
+/* --- Asymmetric keys --------------------------------------------------------------------------- */
+
+static const char *curve_name( const struct key *key )
+{
+    switch (key->u.a.curve_id)
+    {
+    case ECC_CURVE_P256R1: return "prime256v1";
+    case ECC_CURVE_P384R1: return "secp384r1";
+    case ECC_CURVE_P521R1: return "secp521r1";
+    default: break;
+    }
+    switch (key->alg_id)
+    {
+    case ALG_ID_ECDH_P256:
+    case ALG_ID_ECDSA_P256: return "prime256v1";
+    case ALG_ID_ECDH_P384:
+    case ALG_ID_ECDSA_P384: return "secp384r1";
+    case ALG_ID_ECDH_P521:
+    case ALG_ID_ECDSA_P521: return "secp521r1";
+    default: return NULL;
+    }
+}
+
+/* a public key from parameters: the key's, in place of what it had */
+static NTSTATUS set_public_key( struct key *key, const char *type, OSSL_PARAM_BLD *bld )
+{
+    OSSL_PARAM *params = OSSL_PARAM_BLD_to_param( bld );
+    EVP_PKEY_CTX *ctx = EVP_PKEY_CTX_new_from_name( NULL, type, NULL );
+    EVP_PKEY *pkey = NULL;
+    NTSTATUS status = STATUS_INTERNAL_ERROR;
+
+    if (params && ctx && EVP_PKEY_fromdata_init( ctx ) > 0 &&
+        EVP_PKEY_fromdata( ctx, &pkey, EVP_PKEY_PUBLIC_KEY, params ) > 0)
+    {
+        EVP_PKEY_free( KEY_PKEY(key) );
+        KEY_PKEY(key) = pkey;
+        status = STATUS_SUCCESS;
+    }
+    else WARN( "%s public key not imported\n", type );
+    EVP_PKEY_CTX_free( ctx );
+    OSSL_PARAM_free( params );
+    return status;
+}
+
+static NTSTATUS import_ecc_public( struct key *key, UCHAR *buf, ULONG len )
+{
+    const BCRYPT_ECCKEY_BLOB *blob = (const BCRYPT_ECCKEY_BLOB *)buf;
+    const char *group = curve_name( key );
+    OSSL_PARAM_BLD *bld;
+    UCHAR *point;
+    NTSTATUS status = STATUS_NO_MEMORY;
+
+    if (!group)
+    {
+        FIXME( "algorithm %u, curve %u not supported\n", key->alg_id, key->u.a.curve_id );
+        return STATUS_NOT_IMPLEMENTED;
+    }
+    if (len < sizeof(*blob) || len - sizeof(*blob) < 2 * (ULONGLONG)blob->cbKey) return STATUS_INVALID_PARAMETER;
+    if (!(point = malloc( 1 + 2 * blob->cbKey ))) return STATUS_NO_MEMORY;
+    point[0] = 4;  /* uncompressed: X then Y */
+    memcpy( point + 1, buf + sizeof(*blob), 2 * blob->cbKey );
+    if ((bld = OSSL_PARAM_BLD_new()))
+    {
+        if (OSSL_PARAM_BLD_push_utf8_string( bld, OSSL_PKEY_PARAM_GROUP_NAME, group, 0 ) &&
+            OSSL_PARAM_BLD_push_octet_string( bld, OSSL_PKEY_PARAM_PUB_KEY, point, 1 + 2 * blob->cbKey ))
+            status = set_public_key( key, "EC", bld );
+        else status = STATUS_INTERNAL_ERROR;
+        OSSL_PARAM_BLD_free( bld );
+    }
+    free( point );
+    return status;
+}
+
+static NTSTATUS import_rsa_public( struct key *key, UCHAR *buf, ULONG len )
+{
+    const BCRYPT_RSAKEY_BLOB *blob = (const BCRYPT_RSAKEY_BLOB *)buf;
+    BIGNUM *e, *n;
+    OSSL_PARAM_BLD *bld;
+    NTSTATUS status = STATUS_NO_MEMORY;
+
+    if (len < sizeof(*blob) || len - sizeof(*blob) < (ULONGLONG)blob->cbPublicExp + blob->cbModulus)
+        return STATUS_INVALID_PARAMETER;
+    e = BN_bin2bn( buf + sizeof(*blob), blob->cbPublicExp, NULL );
+    n = BN_bin2bn( buf + sizeof(*blob) + blob->cbPublicExp, blob->cbModulus, NULL );
+    if (e && n && (bld = OSSL_PARAM_BLD_new()))
+    {
+        if (OSSL_PARAM_BLD_push_BN( bld, OSSL_PKEY_PARAM_RSA_N, n ) &&
+            OSSL_PARAM_BLD_push_BN( bld, OSSL_PKEY_PARAM_RSA_E, e ))
+            status = set_public_key( key, "RSA", bld );
+        else status = STATUS_INTERNAL_ERROR;
+        OSSL_PARAM_BLD_free( bld );
+    }
+    BN_free( e );
+    BN_free( n );
+    return status;
+}
+
+static NTSTATUS key_asymmetric_import( void *args )
+{
+    const struct key_asymmetric_import_params *params = args;
+    struct key *key = params->key;
+
+    switch (key->alg_id)
+    {
+    case ALG_ID_ECDH:
+    case ALG_ID_ECDH_P256:
+    case ALG_ID_ECDH_P384:
+    case ALG_ID_ECDH_P521:
+    case ALG_ID_ECDSA:
+    case ALG_ID_ECDSA_P256:
+    case ALG_ID_ECDSA_P384:
+    case ALG_ID_ECDSA_P521:
+        if (params->flags & KEY_IMPORT_FLAG_PUBLIC) return import_ecc_public( key, params->buf, params->len );
+        break;
+    case ALG_ID_RSA:
+    case ALG_ID_RSA_SIGN:
+        if (params->flags & KEY_IMPORT_FLAG_PUBLIC) return import_rsa_public( key, params->buf, params->len );
+        break;
+    default:
+        break;
+    }
+    FIXME( "algorithm %u, flags %#x: only RSA and ECC public keys on the PS4\n", key->alg_id, (UINT)params->flags );
+    return STATUS_NOT_IMPLEMENTED;
+}
+
+static const EVP_MD *get_digest( const WCHAR *alg_id )
+{
+    if (!wcscmp( alg_id, BCRYPT_SHA1_ALGORITHM ))   return EVP_sha1();
+    if (!wcscmp( alg_id, BCRYPT_SHA256_ALGORITHM )) return EVP_sha256();
+    if (!wcscmp( alg_id, BCRYPT_SHA384_ALGORITHM )) return EVP_sha384();
+    if (!wcscmp( alg_id, BCRYPT_SHA512_ALGORITHM )) return EVP_sha512();
+    if (!wcscmp( alg_id, BCRYPT_MD5_ALGORITHM ))    return EVP_md5();
+    return NULL;
+}
+
+/* an ECDSA signature as bcrypt has it (r then s, half each) in OpenSSL's DER: its length, or 0 */
+static int ecdsa_der( const UCHAR *signature, ULONG len, UCHAR **der )
+{
+    ECDSA_SIG *sig = ECDSA_SIG_new();
+    BIGNUM *r = BN_bin2bn( signature, len / 2, NULL ), *s = BN_bin2bn( signature + len / 2, len / 2, NULL );
+    int der_len = 0;
+
+    *der = NULL;
+    if (sig && r && s && ECDSA_SIG_set0( sig, r, s ))
+    {
+        r = s = NULL;  /* (the signature's now) */
+        if ((der_len = i2d_ECDSA_SIG( sig, der )) < 0) der_len = 0;
+    }
+    BN_free( r );
+    BN_free( s );
+    ECDSA_SIG_free( sig );
+    return der_len;
+}
+
+static NTSTATUS key_asymmetric_verify( void *args )
+{
+    const struct key_asymmetric_verify_params *params = args;
+    struct key *key = params->key;
+    EVP_PKEY_CTX *ctx;
+    UCHAR *der = NULL;
+    int ret = 0;
+
+    if (!KEY_PKEY(key)) return STATUS_INVALID_PARAMETER;
+    if (!(ctx = EVP_PKEY_CTX_new( KEY_PKEY(key), NULL ))) return STATUS_NO_MEMORY;
+    if (EVP_PKEY_verify_init( ctx ) <= 0)
+    {
+        EVP_PKEY_CTX_free( ctx );
+        return STATUS_INTERNAL_ERROR;
+    }
+    switch (key->alg_id)
+    {
+    case ALG_ID_ECDSA:
+    case ALG_ID_ECDSA_P256:
+    case ALG_ID_ECDSA_P384:
+    case ALG_ID_ECDSA_P521:
+    {
+        const int der_len = ecdsa_der( params->signature, params->signature_len, &der );
+
+        /* (the hash as it is: only its size has to fit the curve) */
+        if (der_len) ret = EVP_PKEY_verify( ctx, der, der_len, params->hash, params->hash_len );
+        break;
+    }
+    case ALG_ID_RSA:
+    case ALG_ID_RSA_SIGN:
+        if (params->flags & BCRYPT_PAD_PKCS1)
+        {
+            const BCRYPT_PKCS1_PADDING_INFO *info = params->padding;
+            const EVP_MD *md = NULL;
+
+            if (!info) goto invalid;
+            if (info->pszAlgId && !(md = get_digest( info->pszAlgId )))
+            {
+                FIXME( "hash algorithm %s not supported\n", debugstr_w(info->pszAlgId) );
+                EVP_PKEY_CTX_free( ctx );
+                return STATUS_NOT_SUPPORTED;
+            }
+            /* (no hash algorithm: the raw PKCS #1 block, TLS 1.0's MD5 and SHA-1 together) */
+            if (EVP_PKEY_CTX_set_rsa_padding( ctx, RSA_PKCS1_PADDING ) <= 0 ||
+                (md && EVP_PKEY_CTX_set_signature_md( ctx, md ) <= 0))
+                break;
+        }
+        else if (params->flags & BCRYPT_PAD_PSS)
+        {
+            const BCRYPT_PSS_PADDING_INFO *info = params->padding;
+            const EVP_MD *md;
+
+            if (!info || !info->pszAlgId) goto invalid;
+            if (!(md = get_digest( info->pszAlgId )))
+            {
+                FIXME( "hash algorithm %s not supported\n", debugstr_w(info->pszAlgId) );
+                EVP_PKEY_CTX_free( ctx );
+                return STATUS_NOT_SUPPORTED;
+            }
+            if (EVP_PKEY_CTX_set_rsa_padding( ctx, RSA_PKCS1_PSS_PADDING ) <= 0 ||
+                EVP_PKEY_CTX_set_signature_md( ctx, md ) <= 0 ||
+                EVP_PKEY_CTX_set_rsa_pss_saltlen( ctx, info->cbSalt ) <= 0)
+                break;
+        }
+        else goto invalid;
+        ret = EVP_PKEY_verify( ctx, params->signature, params->signature_len, params->hash, params->hash_len );
+        break;
+    default:
+        FIXME( "algorithm %u not supported\n", key->alg_id );
+        EVP_PKEY_CTX_free( ctx );
+        return STATUS_NOT_IMPLEMENTED;
+    }
+    OPENSSL_free( der );
+    EVP_PKEY_CTX_free( ctx );
+    return ret == 1 ? STATUS_SUCCESS : STATUS_INVALID_SIGNATURE;
+
+invalid:
+    EVP_PKEY_CTX_free( ctx );
+    return STATUS_INVALID_PARAMETER;
+}
+
+static NTSTATUS key_asymmetric_duplicate( void *args )
+{
+    const struct key_asymmetric_duplicate_params *params = args;
+    EVP_PKEY *pkey = KEY_PKEY(params->key_orig);
+
+    if (pkey && !EVP_PKEY_up_ref( pkey )) return STATUS_INTERNAL_ERROR;
+    KEY_PKEY(params->key_copy) = pkey;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS key_asymmetric_destroy( void *args )
+{
+    struct key *key = args;
+
+    EVP_PKEY_free( KEY_PKEY(key) );
+    KEY_PKEY(key) = NULL;
+    return STATUS_SUCCESS;
+}
