From 74314df563b182f74f63b1fe82406aaa58cd2b59 Mon Sep 17 00:00:00 2001
From: iHaiDeeZ <ihaideezi@gmail.com>
Date: Wed, 4 Nov 2026 05:46:17 +0300
Subject: [PATCH 33/38] PS4: helper programs that would only take one of the 7
 processes are refused (Steam's start-up probes, install scripts and overlay)

---
 dlls/ntdll/unix/process.c | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
index 6827f0e..ad54f06 100644
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -827,6 +827,30 @@ static WCHAR *ps4_one_process_cmdline( const char *unix_name, const UNICODE_STRI
     MESSAGE( "wineps4: %s runs in one process (a Chromium program)\n", slash + 1 );
     return ret;
 }
+
+/* Programs left out (Settings > Apps, on by default; WINEPS4_PROCESS_RULES=0 runs them all): each would
+ * take one of the 7 processes the PS4 runs for the app, and they do nothing useful here: Steam's
+ * start-up probes, its install-script runner and its overlay window (PS5_MihawkOS left out the same
+ * on the PS5). Refused as Windows refuses a program it may not run: the one asking goes on without it. */
+static BOOL ps4_refused_program( const char *unix_name, const UNICODE_STRING *cmdline )
+{
+    static const char *const refused[] = { "steamsysinfo.exe", "gldriverquery.exe", "gldriverquery64.exe",
+                                           "vulkandriverquery.exe", "vulkandriverquery64.exe", "gameoverlayui.exe",
+                                           "gameoverlayui64.exe" };
+    const char *setting = getenv( "WINEPS4_PROCESS_RULES" ), *slash;
+    unsigned int i;
+
+    if ((setting && !strcmp( setting, "0" )) || !unix_name || !(slash = strrchr( unix_name, '/' ))) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(refused); i++)
+        if (!strcasecmp( slash + 1, refused[i] )) break;
+    /* (SteamService.exe /installscript: the redistributables' installers; as a service it stays) */
+    if (i == ARRAY_SIZE(refused) &&
+        (strcasecmp( slash + 1, "steamservice.exe" ) ||
+         !ps4_has_switch( cmdline->Buffer, cmdline->Length / sizeof(WCHAR), "/installscript" )))
+        return FALSE;
+    MESSAGE( "wineps4: %s left out (it would take one of the PS4's 7 processes)\n", slash + 1 );
+    return TRUE;
+}
 #endif
 
 /**********************************************************************
@@ -923,6 +947,13 @@ NTSTATUS WINAPI NtCreateUserProcess( HANDLE *process_handle_ptr, HANDLE *thread_
         }
         goto done;
     }
+#ifdef __PS4_WINE__
+    if (ps4_refused_program( unix_name, &params->CommandLine ))
+    {
+        status = STATUS_ACCESS_DENIED;
+        goto done;
+    }
+#endif
     if (!machine)
     {
         machine = pe_info.machine;
-- 
