From 9f77cbb583f218c0e08a86119fe26e074386bcd0 Mon Sep 17 00:00:00 2001
From: iHaiDeeZ <ihaideezi@gmail.com>
Date: Sat, 31 Oct 2026 20:29:13 +0300
Subject: [PATCH 3/3] ntdll: set up the prefix (dosdevices) before starting the
 in-process server

---
 dlls/ntdll/unix/server.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index 3507172..e9660ef 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1405,6 +1405,9 @@ extern int ps4_start_wineserver( void );
 static int server_connect(void)
 {
 #ifdef __PS4_WINE__
+    /* the prefix with its dosdevices links, then the server as a thread of this process */
+    initial_cwd = setup_config_dir();
+    fchdir( initial_cwd );
     return ps4_start_wineserver();
 #endif
     struct sockaddr_un addr;
-- 
2.53.0

