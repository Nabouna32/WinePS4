From 5c3b61688fcf27b7b59bbc1fc07529fad2b4d4ec Mon Sep 17 00:00:00 2001
From: iHaiDeeZ <ihaideezi@gmail.com>
Date: Wed, 4 Nov 2026 04:45:01 +0300
Subject: [PATCH 31/38] PS4: a Chromium browser's first process gets the
 switches that keep it in one process (the PS4 runs 7 for the app)

---
 dlls/ntdll/unix/process.c | 66 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 66 insertions(+)

diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
index fa78872..6827f0e 100644
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -781,6 +781,54 @@ static NTSTATUS alloc_handle_list( const PS_ATTRIBUTE *handles_attr, obj_handle_
     return STATUS_SUCCESS;
 }
 
+#ifdef __PS4_WINE__
+/* whether the command line has the ASCII switch name (lowercase), anywhere */
+static BOOL ps4_has_switch( const WCHAR *line, DWORD len, const char *name )
+{
+    DWORD n = strlen( name ), i, j;
+
+    for (i = 0; i + n <= len; i++)
+    {
+        for (j = 0; j < n && (line[i + j] >= 0x41 && line[i + j] <= 0x5a ? line[i + j] | 0x20 : line[i + j]) == (unsigned char)name[j]; j++) ;
+        if (j == n) return TRUE;
+    }
+    return FALSE;
+}
+
+/* A Chromium browser (Chrome, Edge, Steam's web view, CEF and Electron programs) starts processes
+ * for its pages, its GPU, its network, ...: more than the 7 the PS4 runs for an app, Windows' own 4
+ * among them. Its first process gets the switches that keep all of it in one (Settings > Apps, on
+ * by default): the command line with them (malloc'd), or NULL. */
+static WCHAR *ps4_one_process_cmdline( const char *unix_name, const UNICODE_STRING *cmdline )
+{
+    static const char *const browsers[] = { "chrome.exe", "msedge.exe", "brave.exe", "vivaldi.exe", "opera.exe",
+                                            "steamwebhelper.exe", "msedgewebview2.exe" };
+    static const char *const markers[] = { "libcef.dll", "v8_context_snapshot.bin", "chrome_100_percent.pak" };
+    static const char switches[] = " --single-process --no-sandbox --in-process-gpu --disable-gpu --disable-breakpad";
+    const char *setting = getenv( "WINEPS4_CHROMIUM_ONE_PROCESS" ), *slash;
+    DWORD len = cmdline->Length / sizeof(WCHAR), i;
+    BOOL chromium = FALSE;
+    char path[4096];
+    WCHAR *ret;
+
+    if ((setting && !strcmp( setting, "0" )) || !unix_name || !(slash = strrchr( unix_name, '/' ))) return NULL;
+    /* (a process it started, --type=renderer and the like, or one that has them already) */
+    if (ps4_has_switch( cmdline->Buffer, len, "--type=" ) || ps4_has_switch( cmdline->Buffer, len, "--single-process" ))
+        return NULL;
+    for (i = 0; i < ARRAY_SIZE(browsers) && !chromium; i++) chromium = !strcasecmp( slash + 1, browsers[i] );
+    for (i = 0; i < ARRAY_SIZE(markers) && !chromium; i++)
+    {
+        snprintf( path, sizeof(path), "%.*s/%s", (int)(slash - unix_name), unix_name, markers[i] );
+        chromium = !access( path, F_OK );
+    }
+    if (!chromium || !(ret = malloc( (len + sizeof(switches)) * sizeof(WCHAR) ))) return NULL;
+    memcpy( ret, cmdline->Buffer, len * sizeof(WCHAR) );
+    for (i = 0; i < sizeof(switches); i++) ret[len + i] = (unsigned char)switches[i];
+    MESSAGE( "wineps4: %s runs in one process (a Chromium program)\n", slash + 1 );
+    return ret;
+}
+#endif
+
 /**********************************************************************
  *           NtCreateUserProcess  (NTDLL.@)
  */
@@ -881,8 +929,26 @@ NTSTATUS WINAPI NtCreateUserProcess( HANDLE *process_handle_ptr, HANDLE *thread_
         if (is_arm64ec() && pe_info.is_hybrid && machine == IMAGE_FILE_MACHINE_ARM64)
             machine = main_image_info.Machine;
     }
+#ifdef __PS4_WINE__
+    {
+        UNICODE_STRING command_line = params->CommandLine;
+        WCHAR *one_process = ps4_one_process_cmdline( unix_name, &params->CommandLine );
+
+        /* (the caller's parameters keep their own: the new process's are made from these) */
+        if (one_process)
+        {
+            params->CommandLine.Buffer = one_process;
+            params->CommandLine.Length = params->CommandLine.MaximumLength = wcslen( one_process ) * sizeof(WCHAR);
+        }
+        startup_info = create_startup_info( attr.ObjectName, process_flags, params, &pe_info, &startup_info_size );
+        params->CommandLine = command_line;
+        free( one_process );
+        if (!startup_info) goto done;
+    }
+#else
     if (!(startup_info = create_startup_info( attr.ObjectName, process_flags, params, &pe_info, &startup_info_size )))
         goto done;
+#endif
     env_size = get_env_size( params, &winedebug );
 
     if ((status = alloc_object_attributes( process_attr, &objattr, &attr_len ))) goto done;
-- 
