+#endif
 
     if (!fd->inode || !fd->unix_name)
     {
@@ -2964,8 +3209,29 @@ static void set_fd_name( struct fd *fd, struct fd *root, const char *nameptr, da
 
     free( fd->nt_name );
     fd->nt_name = dup_nt_name( root, nt_name, &fd->nt_namelen );
+#ifdef __PS4_WINE__
+    {
+        /* (the file's other fds open it again by name when parked) */
