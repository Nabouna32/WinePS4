From f4a85ec1d83c56b3295f0b8687f970cc289715e5 Mon Sep 17 00:00:00 2001
From: iHaiDeeZ <ihaideezi@gmail.com>
Date: Thu, 5 Nov 2026 02:18:26 +0300
Subject: [PATCH 37/38] PS4: the PS4's keyboard for a text field clicked: msctf
 tells the display driver which field Chromium's text services focus (a text
 store, a password context); the driver sends that and the carets win32u shows
 to the desktop

---
 dlls/msctf/Makefile.in         |  2 +-
 dlls/msctf/context.c           | 24 ++++++++++++++++++++
 dlls/msctf/msctf_internal.h    |  1 +
 dlls/msctf/threadmgr.c         | 19 ++++++++++++++++
 dlls/wineps4.drv/ps4_display.h | 12 ++++++++++
 dlls/wineps4.drv/ps4drv.h      |  2 ++
 dlls/wineps4.drv/ps4drv_main.c |  2 ++
 dlls/wineps4.drv/window.c      | 41 ++++++++++++++++++++++++++++++++++
 8 files changed, 102 insertions(+), 1 deletion(-)

diff --git a/dlls/msctf/Makefile.in b/dlls/msctf/Makefile.in
index 917c78b..7d26954 100644
--- a/dlls/msctf/Makefile.in
+++ b/dlls/msctf/Makefile.in
@@ -1,5 +1,5 @@
 MODULE    = msctf.dll
-IMPORTS   = uuid ole32 oleaut32 user32 advapi32
+IMPORTS   = uuid ole32 oleaut32 user32 advapi32 win32u
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
diff --git a/dlls/msctf/context.c b/dlls/msctf/context.c
index 2a7feaf..1b355d1 100644
--- a/dlls/msctf/context.c
+++ b/dlls/msctf/context.c
@@ -1112,6 +1112,30 @@ HRESULT Context_Initialize(ITfContext *iface, ITfDocumentMgr *manager)
     return S_OK;
 }
 
+/* WinePS4: what a context takes, for the PS4's keyboard (threadmgr.c): 0 no text (no text store, or a
+ * read-only one), 1 text, 2 a password (Chromium disables the keyboard of a password field's context) */
+int Context_TextKind(ITfContext *iface)
+{
+    Context *This = impl_from_ITfContext(iface);
+    TS_STATUS status = {0};
+    ITfCompartment *compartment;
+    VARIANT value;
+    int kind = 1;
+
+    if (!This->pITextStoreACP) return 0;
+    if (SUCCEEDED(ITextStoreACP_GetStatus(This->pITextStoreACP, &status)) && (status.dwDynamicFlags & TS_SD_READONLY))
+        return 0;
+    if (SUCCEEDED(ITfCompartmentMgr_GetCompartment(This->CompartmentMgr, &GUID_COMPARTMENT_KEYBOARD_DISABLED, &compartment)))
+    {
+        VariantInit(&value);
+        if (SUCCEEDED(ITfCompartment_GetValue(compartment, &value)) && V_VT(&value) == VT_I4 && V_I4(&value))
+            kind = 2;
+        VariantClear(&value);
+        ITfCompartment_Release(compartment);
+    }
+    return kind;
+}
+
 HRESULT Context_Uninitialize(ITfContext *iface)
 {
     Context *This = impl_from_ITfContext(iface);
diff --git a/dlls/msctf/msctf_internal.h b/dlls/msctf/msctf_internal.h
index 1d94fa1..2e37b60 100644
--- a/dlls/msctf/msctf_internal.h
+++ b/dlls/msctf/msctf_internal.h
@@ -53,6 +53,7 @@ extern HRESULT DisplayAttributeMgr_Constructor(IUnknown *pUnkOuter, IUnknown **p
 
 extern HRESULT Context_Initialize(ITfContext *cxt, ITfDocumentMgr *manager);
 extern HRESULT Context_Uninitialize(ITfContext *cxt);
+extern int     Context_TextKind(ITfContext *cxt);
 extern void    ThreadMgr_OnDocumentMgrDestruction(ITfThreadMgr *tm, ITfDocumentMgr *mgr);
 extern HRESULT TF_SELECTION_to_TS_SELECTION_ACP(const TF_SELECTION *tf, TS_SELECTION_ACP *tsAcp);
 
diff --git a/dlls/msctf/threadmgr.c b/dlls/msctf/threadmgr.c
index 11c79c0..5b5dd11 100644
--- a/dlls/msctf/threadmgr.c
+++ b/dlls/msctf/threadmgr.c
@@ -33,6 +33,7 @@
 #include "olectl.h"
 
 #include "msctf.h"
+#include "ntuser.h"
 #include "msctf_internal.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(msctf);
@@ -363,6 +364,23 @@ static HRESULT WINAPI ThreadMgr_GetFocus(ITfThreadMgrEx *iface, ITfDocumentMgr *
     return S_OK;
 }
 
+/* WinePS4: the PS4's keyboard opens for a text field clicked in a program. Chromium (Steam's web
+ * helper) focuses a document whose context has a text store for a text field, one without for the
+ * rest of a page: which one, to the display driver (wineps4.drv's NotifyIMEStatus, PS4_TEXT_STATUS in
+ * port/include/ps4_display.h), then the desktop */
+static void ps4_text_focus(ITfDocumentMgr *docmgr)
+{
+    ITfContext *context = NULL;
+    int kind = 0;
+
+    if (docmgr && SUCCEEDED(ITfDocumentMgr_GetTop(docmgr, &context)) && context)
+    {
+        kind = Context_TextKind(context);
+        ITfContext_Release(context);
+    }
+    NtUserNotifyIMEStatus(GetFocus(), 0x57505300 | kind);
+}
+
 static HRESULT WINAPI ThreadMgr_SetFocus(ITfThreadMgrEx *iface, ITfDocumentMgr *pdimFocus)
 {
     ThreadMgr *This = impl_from_ITfThreadMgrEx(iface);
@@ -381,6 +399,7 @@ static HRESULT WINAPI ThreadMgr_SetFocus(ITfThreadMgrEx *iface, ITfDocumentMgr *
         ITfDocumentMgr_Release(This->focus);
 
     This->focus = check;
+    ps4_text_focus(check);
     return S_OK;
 }
 
diff --git a/dlls/wineps4.drv/ps4_display.h b/dlls/wineps4.drv/ps4_display.h
index 86f270d..f1afb26 100755
--- a/dlls/wineps4.drv/ps4_display.h
+++ b/dlls/wineps4.drv/ps4_display.h
@@ -28,6 +28,8 @@ enum ps4_display_msg
     PS4_DISPLAY_TITLE,      /* UTF-8 title follows (size - header) */
     PS4_DISPLAY_DESTROY,    /* the window is gone */
     PS4_DISPLAY_RAISE,      /* the window was activated: on top */
+    PS4_DISPLAY_TEXT,       /* what takes text in the window now (flags = PS4_TEXT_*): the desktop opens
+                               the PS4's keyboard for a text field clicked */
 };
 
 #define PS4_WINDOW_VISIBLE      0x001
@@ -40,6 +42,16 @@ enum ps4_display_msg
 #define PS4_WINDOW_CAN_MINIMIZE 0x080
 #define PS4_WINDOW_CAN_MAXIMIZE 0x100
 
+/* TEXT: a caret shown or moved in the window (Windows' edit boxes: left..bottom is it on the screen), or
+ * the field Chromium's text services focus (msctf: none, a text field or a password field) */
+#define PS4_TEXT_NONE     0x0
+#define PS4_TEXT_FIELD    0x1
+#define PS4_TEXT_PASSWORD 0x2
+#define PS4_TEXT_CARET    0x4
+/* msctf tells the display driver through NotifyIMEStatus: this or'ed with NONE, FIELD or PASSWORD
+ * (imm32's own statuses are the IME's open state, 0 or 1) */
+#define PS4_TEXT_STATUS   0x57505300
+
 struct ps4_display_header
 {
     uint32_t type;
diff --git a/dlls/wineps4.drv/ps4drv.h b/dlls/wineps4.drv/ps4drv.h
index a9d8a44..926224d 100755
--- a/dlls/wineps4.drv/ps4drv.h
+++ b/dlls/wineps4.drv/ps4drv.h
@@ -36,6 +36,8 @@ extern void PS4DRV_DestroyWindow( HWND hwnd );
 extern void PS4DRV_SetWindowText( HWND hwnd, LPCWSTR text );
 extern void PS4DRV_ActivateWindow( HWND hwnd, HWND previous );
 extern LRESULT PS4DRV_SysCommand( HWND hwnd, WPARAM wparam, LPARAM lparam, const POINT *pos );
+extern BOOL PS4DRV_SetIMECompositionRect( HWND hwnd, RECT rect );
+extern void PS4DRV_NotifyIMEStatus( HWND hwnd, UINT status );
 
 /* ps4drv_main.c: the desktop's socket */
 extern BOOL ps4drv_send( const struct ps4_display_header *header, const void *data, UINT data_size );
diff --git a/dlls/wineps4.drv/ps4drv_main.c b/dlls/wineps4.drv/ps4drv_main.c
index 739ac3a..ce02e79 100755
--- a/dlls/wineps4.drv/ps4drv_main.c
+++ b/dlls/wineps4.drv/ps4drv_main.c
@@ -132,6 +132,8 @@ static const struct user_driver_funcs ps4drv_funcs =
     .pActivateWindow = PS4DRV_ActivateWindow,
     .pCreateWindowSurface = PS4DRV_CreateWindowSurface,
     .pDestroyWindow = PS4DRV_DestroyWindow,
+    .pNotifyIMEStatus = PS4DRV_NotifyIMEStatus,
+    .pSetIMECompositionRect = PS4DRV_SetIMECompositionRect,
     .pSetWindowText = PS4DRV_SetWindowText,
     .pSysCommand = PS4DRV_SysCommand,
     .pUpdateDisplayDevices = PS4DRV_UpdateDisplayDevices,
diff --git a/dlls/wineps4.drv/window.c b/dlls/wineps4.drv/window.c
index 6da5fbe..43df3fd 100755
--- a/dlls/wineps4.drv/window.c
+++ b/dlls/wineps4.drv/window.c
@@ -191,6 +191,47 @@ LRESULT PS4DRV_SysCommand( HWND hwnd, WPARAM wparam, LPARAM lparam, const POINT
     return 0;
 }
 
+/* --- text: the desktop opens the PS4's keyboard for a text field clicked -------------------------- */
+
+static void send_text( HWND hwnd, UINT flags, const RECT *caret )
+{
+    static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+    static struct ps4_display_header last;
+    struct ps4_display_header msg = { .type = PS4_DISPLAY_TEXT, .hwnd = (UINT_PTR)hwnd, .flags = flags };
+    BOOL same;
+
+    if (caret)
+    {
+        msg.left   = caret->left;
+        msg.top    = caret->top;
+        msg.right  = caret->right;
+        msg.bottom = caret->bottom;
+    }
+    /* (edit boxes show their caret again after each paint: once is enough) */
+    pthread_mutex_lock( &lock );
+    same = last.type && last.hwnd == msg.hwnd && last.flags == msg.flags && last.left == msg.left &&
+           last.top == msg.top && last.right == msg.right && last.bottom == msg.bottom;
+    last = msg;
+    pthread_mutex_unlock( &lock );
+    if (!same) ps4drv_send( &msg, NULL, 0 );
+}
+
+/* a caret shown or moved (win32u: the IME's composition window follows it): hwnd is its top-level
+ * window, rect on the screen */
+BOOL PS4DRV_SetIMECompositionRect( HWND hwnd, RECT rect )
+{
+    send_text( hwnd, PS4_TEXT_CARET, &rect );
+    return TRUE;
+}
+
+/* msctf's (PS4_TEXT_STATUS): the field Chromium's text services focus now */
+void PS4DRV_NotifyIMEStatus( HWND hwnd, UINT status )
+{
+    if ((status & ~0xff) != PS4_TEXT_STATUS) return;  /* imm32's: the IME opened or closed */
+    if (hwnd) hwnd = NtUserGetAncestor( hwnd, GA_ROOT );
+    send_text( hwnd, status & (PS4_TEXT_FIELD | PS4_TEXT_PASSWORD), NULL );
+}
+
 void PS4DRV_DestroyWindow( HWND hwnd )
 {
     struct ps4_display_header msg = { .type = PS4_DISPLAY_DESTROY, .hwnd = (UINT_PTR)hwnd };
-- 
