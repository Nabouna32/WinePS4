From dab06a9774f2a58d35ca99ab826feaeaa02c0141 Mon Sep 17 00:00:00 2001
From: iHaiDeeZ <ihaideezi@gmail.com>
Date: Sat, 31 Oct 2026 21:00:06 +0300
Subject: [PATCH 04/38] server: send the first thread its request pipe in the
 in-process start

---
 server/main.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/server/main.c b/server/main.c
index 4b4c083..da7531c 100644
--- a/server/main.c
+++ b/server/main.c
@@ -250,6 +250,8 @@ extern void ps4_server_dir_init(void);
  * of its own). */
 int ps4_wineserver_main( int client_fd )
 {
+    struct process *process;
+
     server_argv0 = "wineserver";
     foreground = 1;
     if (getenv( "WINEPS4_SERVER_DEBUG" )) debug_level = atoi( getenv( "WINEPS4_SERVER_DEBUG" ));
@@ -262,8 +264,12 @@ int ps4_wineserver_main( int client_fd )
     init_directories( load_intl_file() );
     init_threading();
     init_registry();
-    if (!create_process( client_fd, NULL, 0, NULL, NULL, NULL, 0, NULL ))
+    /* what master_socket_poll_event does for a client that connects */
+    fcntl( client_fd, F_SETFL, O_NONBLOCK );
+    if (!(process = create_process( client_fd, NULL, 0, NULL, NULL, NULL, 0, NULL )))
         fatal_error( "wineserver: could not create the first process\n" );
+    create_thread( -1, process, NULL );  /* sends ntdll its request pipe and the protocol version */
+    release_object( process );
     main_loop();
     return 0;
 }
-- 
