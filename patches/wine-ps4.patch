 {
     struct stat st;
+#ifdef __PS4_WINE__
+    if (fd->parked && !unpark_fd( fd )) return;
+    park_touch( fd );
+#endif
 
     if (!fd->inode)
     {
@@ -2842,6 +3083,10 @@ static void set_fd_name( struct fd *fd, struct fd *root, const char *nameptr, da
     struct stat st, st2;
     char *name;
     const unsigned int replace = flags & FILE_RENAME_REPLACE_IF_EXISTS;
+#ifdef __PS4_WINE__
+    if (fd->parked && !unpark_fd( fd )) return;
