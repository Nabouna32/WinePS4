 7 files changed, 66 insertions(+), 9 deletions(-)

diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index cb700dd..a499899 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -448,10 +448,14 @@ static void set_config_dir(void)
 
 static void init_paths(void)
 {
+#ifdef __PS4_WINE__
+    ntdll_dir = strdup( LIBDIR "/wine/x86_64-unix" );
+#else
     Dl_info info;
 
     if (!dladdr( init_paths, &info ) || !(ntdll_dir = realpath_dirname( info.dli_fname )))
         fatal_error( "cannot get path to ntdll.so\n" );
+#endif
 
     if ((build_dir = remove_tail( ntdll_dir, "/dlls/ntdll" )))
     {
diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index 258a959..3507172 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1305,7 +1305,7 @@ static const char *init_server_dir( dev_t dev, ino_t ino )
 {
     char *dir = NULL;
 
-#ifdef __ANDROID__  /* there's no /tmp dir on Android */
+#if defined(__ANDROID__) || defined(__PS4_WINE__)  /* there's no /tmp dir on Android */
     asprintf( &dir, "%s/.wineserver/server-%llx-%llx", config_dir, (unsigned long long)dev, (unsigned long long)ino );
 #else
     asprintf( &dir, "/tmp/.wine-%u/server-%llx-%llx", getuid(), (unsigned long long)dev, (unsigned long long)ino );
@@ -1399,8 +1399,14 @@ static void server_connect_error( const char *serverdir )
