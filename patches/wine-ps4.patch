 {
+#ifdef __PS4_WINE__
+    if (fd->parked && !unpark_fd( fd )) return -1;
+    park_touch( fd );
+#endif
     if (fd->unix_fd == -1) set_error( fd->no_fd_status );
     return fd->unix_fd;
 }
@@ -2767,6 +3004,10 @@ static struct fd *get_handle_fd_obj( struct process *process, obj_handle_t handl
